# Application Settings
PROJECT_NAME="RosterIQ - Smart Roster Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security
SECRET_KEY="rosteriq_development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For Local Dev (SQLite): sqlite:///./rosteriq.db
# For Production / Cloud (PostgreSQL on Neon/Supabase/Render):
# DATABASE_URL=postgresql://user:password@ep-host.aws.neon.tech/rosteriq?sslmode=require
DATABASE_URL="sqlite:///./rosteriq.db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
